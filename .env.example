# =============================================================================
# CustoDoce — variáveis de ambiente
# Teste de paridade: tests/unit/test_env_example_parity.py garante que toda
# var lida via os.environ no código está documentada aqui.
# =============================================================================

# ─── Obrigatórias (core) ─────────────────────────────────────────────────────
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Auth do dashboard
AUTH_SECRET_KEY=chave-aleatoria-32-caracteres
ADMIN_PASSWORD=sua-senha-admin
# Hash alternativo (se definido, tem precedência sobre ADMIN_PASSWORD)
# ADMIN_PASSWORD_HASH=
# Iterações PBKDF2 (default 600000)
# AUTH_PBKDF2_ITERATIONS=
# Ambiente: local|production — production exige cookies seguros/2FA
# APP_ENV=production
# Detectado pelo Streamlit Cloud (trata como produção)
# STREAMLIT_SERVER=
# 2FA opcional no login admin
# TOTP_ENABLED=false
# TOTP_SECRET=

# ─── Integrações (opcionais — features degradam sem elas) ────────────────────
# LLM: Groq (classificador + vision OCR), fallback OpenRouter/NVIDIA
GROQ_API_KEY=
# GROQ_MODEL=
# GROQ_VISION_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENROUTER_VISION_MODEL=
# NVIDIA_API_KEY=
# NVIDIA_VISION_MODEL=
# Google Vision/Gemini fallback para OCR de encartes
GOOGLE_API_KEY=

# Telegram (TELEGRAM_TOKEN é o nome legado; TELEGRAM_BOT_TOKEN também aceito)
TELEGRAM_TOKEN=
# TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Chat id alternativo usado por alertas de scraper
# SCRAPER_ALERT_CHAT_ID=
# ALERT_CHAT_ID=

# SMTP (prioridade) / Gmail legado (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=app-password-16chars
SMTP_FROM=seuemail@gmail.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=email-que-recebe-os-relatorios

# VipCommerce (key de login da API — obrigatória p/ lojas tipo vipcommerce_api:
# Spani e Rede Krill). NUNCA colocar em stores.yaml.
VIP_LOGIN_KEY=seu-login-key-vipcommerce

# GitHub (opcional - release automático de backup / API checks)
GH_PAT=

# ─── DB direto (legado — só p/ deploy_database.py --allow-psycopg2 em WSL) ───
# NUNCA usar em CI (porta 5432 bloqueada). Regra AGENTS #4/#18.
# SUPABASE_DB_PASSWORD=
# Staging (scripts de promoção staging→prod)
# SUPABASE_STAGING_URL=
# SUPABASE_STAGING_SERVICE_ROLE_KEY=

# ─── Tuning (defaults sensatos — mexer só sob demanda) ───────────────────────
# HTTP client compartilhado
# HTTP_CLIENT_TIMEOUT=
# HTTP_CLIENT_MAX_RETRIES=
# HTTP_CLIENT_BACKOFF=
# HTTP_CLIENT_POOL_SIZE=
# LLM classifier/cache/circuit-breaker
# LLM_TIMEOUT=
# LLM_RATE_LIMIT=
# LLM_BURST=
# LLM_CACHE_DIR=
# LLM_CACHE_TTL_DAYS=
# LLM_CB_THRESHOLD=
# LLM_CB_COOLDOWN=
# LLM_CB_COOLDOWN_GROWTH=
# LLM_CB_COOLDOWN_MAX=
# Vision (imagens → LLM)
# VISION_MAX_DIM=
# VISION_MAX_BYTES=
# VISION_JPEG_QUALITY=
# VISION_MAX_RETRIES=
# VISION_RETRY_BASE=
# Falha rápido em 429 do provedor vision (sem queimar retries)
# VISION_FAIL_FAST_ON_429=
# Flyer OCR hybrid + layout adaptativo
# FLYER_USE_LAYOUT_ADAPTATION=1
# FLYER_BLOCK_GAP=
# FLYER_BLOCK_X_GAP=
# FLYER_BLOCK_DX=
# FLYER_BLOCK_DY_ABOVE=
# FLYER_BLOCK_DY_BELOW=
# FLYER_BLOCK_MAX_TEXTS=
# FLYER_DENSITY_THRESHOLD=
# FLYER_RAW_QUALITY_THRESHOLD=
# FLYER_HYBRID_CB_THRESHOLD=
# FLYER_HYBRID_CB_COOLDOWN=
# FLYER_HYBRID_LLM_TIMEOUT=
# FLYER_HYBRID_CENTS_UPSCALE=
# FLYER_HYBRID_REFINE_CENTS=
# Scraper health/self-healing
# SCRAPER_HEALTH_THRESHOLD=
# SCRAPER_HEALTH_HEAL_DAYS=
# SCRAPER_HEALTH_RECOVERY_ITEMS=
# Observabilidade
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Dev/CI only ─────────────────────────────────────────────────────────────
# URL do app em produção (validate_streamlit_cloud.py)
STREAMLIT_APP_URL=https://custodoce.streamlit.app
# URL local p/ testes UX (run_ux_tests.py)
# STREAMLIT_URL=http://localhost:8501
# Força scrape ignorando cache ETag; filtra lojas (main.py)
# CUSTODOCE_FORCE_SCRAPE=
# CUSTODOCE_STORES_FILTER=
# Pula envio de email/telegram em dry-runs
# SKIP_SEND=
# Modo auto-fix das fases de validação local
# VALIDATION_AUTO=
# Limites dos testes de calibração de scoring
# EVAL_PRECISION_MIN=
# EVAL_RECALL_MIN=
# EVAL_F1_MIN=
